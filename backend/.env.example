# Generative AI. Leave the key empty to run on the built-in offline template planner.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Supabase. Leave empty to run in demo mode (no login, trips kept in data/trips.json).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5175

# Where demo-mode trips are stored.
DATA_FILE=data/trips.json
